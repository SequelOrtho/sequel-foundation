{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["access", "session", "undo", "graph", "notify", "alerts", "brand", "theme", "ui", "llm", "assistant", "connector", "deck-kit", "docs-kit", "testing", "tests"],
  "exclude": ["node_modules"]
}
